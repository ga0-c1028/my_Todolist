    "/api/categories": {
      "get": {
        "tags": [
          "Categories"
        ],
        "summary": "카테고리 목록 조회",
        "description": "로그인한 사용자 본인의 카테고리 목록을 조회한다. 조회 쿼리는 항상 WHERE user_id = $1 조건을 포함한다(BR-2).",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "조회 성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Category"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      },
      "post": {
        "tags": [
          "Categories"
        ],
        "summary": "카테고리 등록",
        "description": "할일 분류용 카테고리를 생성한다(FR-05). 사용자 내 이름 중복은 허용되지 않는다.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCategoryRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "등록 성공",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Category"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "409": {
            "description": "사용자 내 카테고리 이름 중복",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": "CATEGORY_NAME_ALREADY_EXISTS",
                  "message": "이미 존재하는 카테고리 이름입니다."
                }
              }
            }
          }
        }
      }
    },
    "/api/categories/{id}": {
      "patch": {
        "tags": [
          "Categories"
        ],
        "summary": "카테고리 수정",
        "description": "소유자가 '기본'이 아닌 카테고리의 이름을 수정한다(FR-06). '기본' 카테고리는 수정 불가(BR-4). 타인 소유 카테고리 접근 시 403(BR-2).",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/IdPathParam"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateCategoryRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "수정 성공",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Category"
                }
              }
            }
          },
          "400": {
            "description": "'기본' 카테고리 수정 시도 등 유효성 검증 실패(BR-4)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": "DEFAULT_CATEGORY_IMMUTABLE",
                  "message": "기본 카테고리는 수정할 수 없습니다."
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "delete": {
        "tags": [
          "Categories"
        ],
        "summary": "카테고리 삭제",
        "description": "소유자가 '기본'이 아닌 카테고리를 삭제한다(FR-06). '기본' 카테고리는 삭제 불가(BR-4). 소속 할일은 모두 사용자의 '기본' 카테고리로 자동 이관되며 삭제되지 않는다(BR-5). 타인 소유 카테고리 접근 시 403(BR-2).",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/IdPathParam"
          }
        ],
        "responses": {
          "204": {
            "description": "삭제 성공(본문 없음). 소속 할일은 기본 카테고리로 이관됨(BR-5)."
          },
          "400": {
            "description": "'기본' 카테고리 삭제 시도(BR-4)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": "DEFAULT_CATEGORY_IMMUTABLE",
                  "message": "기본 카테고리는 삭제할 수 없습니다."
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/todos": {
      "get": {
        "tags": [
          "Todos"
        ],
        "summary": "할일 목록 조회",
        "description": "로그인한 사용자 본인의 할일 목록을 조회한다(FR-08). categoryId, status 쿼리 파라미터로 필터링할 수 있다(FR-09, BR-8). 조회 쿼리는 항상 WHERE user_id = $1 조건을 포함한다(BR-2).",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "categoryId",
            "in": "query",
            "required": false,
            "description": "특정 카테고리로 필터링",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "할일 상태로 필터링(BR-8, 도메인 정의서 5장)",
            "schema": {
              "$ref": "#/components/schemas/TodoStatus"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "조회 성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Todo"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      },
      "post": {
        "tags": [
          "Todos"
        ],
        "summary": "할일 등록",
        "description": "제목, 설명(선택), 카테고리(선택), 시작일자·종료일자를 입력해 할일을 생성한다(FR-07). categoryId 미지정 시 '기본' 카테고리로 자동 지정된다(BR-3).",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTodoRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "등록 성공",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Todo"
                }
              }
            }
          },
          "400": {
            "description": "유효성 검증 실패. endDate가 startDate보다 빠른 경우 포함(BR-6)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": "INVALID_DATE_RANGE",
                  "message": "종료일자는 시작일자보다 빠를 수 없습니다."
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
