{
  "openapi": "3.0.3",
  "info": {
    "title": "my_Todolist API",
    "version": "1.0.0",
    "description": "인증 기반 개인 할일 관리 웹앱 my_Todolist의 REST API 명세. 사용자는 회원가입/로그인(JWT access_token + refresh_token) 후 본인 소유의 카테고리와 할일(Todo)을 등록·조회·수정·삭제할 수 있다. 할일은 시작일자·종료일자·완료 여부를 기반으로 조회 시점에 상태(시작 전/진행중/완료/기한초과)가 계산되는 파생 값을 가진다. 근거: docs/1-domain_definition.md(BR-1~BR-11), docs/2-prd.md(FR-01~FR-13), docs/7-erd.md, docs/8-plan.md(BE-03~BE-08).",
    "contact": {
      "name": "gayoung.rho",
      "email": "gayoung.rho@gmail.com"
    }
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "로컬 개발 서버"
    }
  ],
  "tags": [
    {
      "name": "Auth",
      "description": "회원가입/로그인/로그아웃/토큰 재발급 (FR-01~03, FR-13)"
    },
    {
      "name": "Users",
      "description": "회원 정보 수정 (FR-04, BR-10)"
    },
    {
      "name": "Categories",
      "description": "카테고리 등록/조회/수정/삭제 (FR-05~06, BR-3~BR-5)"
    },
    {
      "name": "Todos",
      "description": "할일 등록/조회/수정/삭제 (FR-07~12, BR-2, BR-3, BR-6~BR-8)"
    },
    {
      "name": "Health",
      "description": "헬스 체크"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "회원가입/로그인/로그아웃/토큰 재발급/헬스체크를 제외한 모든 API에 필요한 access_token (BR-1). `Authorization: Bearer <access_token>` 헤더로 전달한다."
      }
    },
    "parameters": {
      "IdPathParam": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "리소스 식별자(UUID)",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "description": "모든 에러 응답의 공통 포맷. 401(BR-1 인증 실패), 403(BR-2 소유권 불일치), 400(유효성 검증 실패) 등에 공통 적용된다.",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "에러 코드 카탈로그 값",
            "enum": [
              "UNAUTHORIZED",
              "FORBIDDEN",
              "VALIDATION_ERROR",
              "NOT_FOUND",
              "EMAIL_ALREADY_EXISTS",
              "INVALID_CREDENTIALS",
              "DEFAULT_CATEGORY_IMMUTABLE",
              "CATEGORY_NAME_ALREADY_EXISTS",
              "INVALID_DATE_RANGE",
              "INVALID_REFRESH_TOKEN",
              "INTERNAL_SERVER_ERROR"
            ],
            "example": "VALIDATION_ERROR"
          },
          "message": {
            "type": "string",
            "example": "종료일자는 시작일자보다 빠를 수 없습니다."
          }
        }
      },
      "User": {
        "type": "object",
        "description": "회원 정보. 도메인 정의서 3.1절 / erd.md 4.1절(users 테이블) 기반. password는 응답에 포함하지 않는다(NFR-03).",
        "required": [
          "id",
          "email",
          "name",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "3fa85f64-5717-4562-b3fc-2c963f66afa6"
          },
          "email": {
            "type": "string",
            "format": "email",
            "description": "로그인 식별자. 가입 후 변경 불가(BR-9).",
            "example": "user@example.com"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30,
            "example": "홍길동"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-08-26T09:00:00.000Z"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-08-26T09:00:00.000Z"
          }
        }
      },
      "Category": {
        "type": "object",
        "description": "할일 분류 단위. 도메인 정의서 3.2절 / erd.md 4.2절(categories 테이블) 기반.",
        "required": [
          "id",
          "userId",
          "name",
          "isDefault"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "b3f1c9a0-1234-4a5b-9c8d-1234567890ab"
          },
          "userId": {
            "type": "string",
            "format": "uuid",
            "example": "3fa85f64-5717-4562-b3fc-2c963f66afa6"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20,
            "description": "사용자 내 고유(중복 불가)",
            "example": "업무"
          },
          "isDefault": {
            "type": "boolean",
            "description": "기본 카테고리 여부(BR-4). 사용자별로 정확히 1개만 true.",
            "example": false
          }
        }
      },
      "TodoStatus": {
        "type": "string",
        "description": "할일 상태. 저장값이 아니라 startDate/endDate/isCompleted로부터 조회 시점에 계산되는 파생 값이다(도메인 정의서 5장). 판단 우선순위: completed > overdue > notStarted > inProgress (BR-7).",
        "enum": [
          "notStarted",
          "inProgress",
          "completed",
          "overdue"
        ],
        "example": "inProgress"
      },
      "Todo": {
        "type": "object",
        "description": "할일 항목. 도메인 정의서 3.3절 / erd.md 4.3절(todos 테이블) 기반.",
        "required": [
          "id",
          "userId",
          "categoryId",
          "title",
          "startDate",
          "endDate",
          "isCompleted",
          "status",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "d290f1ee-6c54-4b01-90e6-d701748f0851"
          },
          "userId": {
            "type": "string",
            "format": "uuid",
            "example": "3fa85f64-5717-4562-b3fc-2c963f66afa6"
          },
          "categoryId": {
            "type": "string",
            "format": "uuid",
            "example": "b3f1c9a0-1234-4a5b-9c8d-1234567890ab"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "example": "API 명세서 작성"
          },
          "description": {
            "type": "string",
            "maxLength": 1000,
            "nullable": true,
            "example": "swagger.json 초안 작성"
          },
          "startDate": {
            "type": "string",
            "format": "date",
            "example": "2026-08-26"
          },
          "endDate": {
            "type": "string",
            "format": "date",
            "description": "startDate 이상이어야 함(BR-6).",
            "example": "2026-08-28"
          },
          "isCompleted": {
            "type": "boolean",
            "default": false,
            "example": false
          },
          "completedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "isCompleted가 true로 바뀔 때 현재 일시로 설정되고, false로 되돌려지면 null로 초기화된다(BR-7).",
            "example": null
          },
          "status": {
            "$ref": "#/components/schemas/TodoStatus"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-08-26T09:00:00.000Z"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-08-26T09:00:00.000Z"
          }
        }
      },
      "SignupRequest": {
        "type": "object",
        "description": "회원가입 요청 (FR-01, BR-9). 가입 성공 시 사용자의 '기본' 카테고리가 함께 생성된다(BR-3, BR-4).",
        "required": [
          "email",
          "password",
          "name"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "user@example.com"
          },
          "password": {
            "type": "string",
            "format": "password",
            "minLength": 8,
            "description": "최소 8자 이상, 영문·숫자 포함",
            "example": "password1"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30,
            "example": "홍길동"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "description": "로그인 요청 (FR-02). 실패 시 이메일 미존재/비밀번호 불일치를 구분하지 않는 동일 메시지로 응답한다(BR-11).",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "user@example.com"
          },
          "password": {
            "type": "string",
            "format": "password",
            "example": "password1"
          }
        }
      },
      "LoginResponse": {
        "type": "object",
        "description": "로그인 성공 응답. access_token(단기)과 refresh_token(장기)을 함께 발급한다(PRD 7.2절).",
        "required": [
          "user",
          "accessToken",
          "refreshToken"
        ],
        "properties": {
          "user": {
            "$ref": "#/components/schemas/User"
          },
          "accessToken": {
            "type": "string",
            "description": "API 요청 인증에 사용하는 단기 JWT",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.access.sig"
          },
          "refreshToken": {
            "type": "string",
            "description": "access_token 재발급에만 사용하는 장기 JWT",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.refresh.sig"
          }
        }
      },
      "LogoutRequest": {
        "type": "object",
        "description": "로그아웃 요청 (FR-03). 제시된 refresh_token을 서버에서 무효화한다.",
        "required": [
          "refreshToken"
        ],
        "properties": {
          "refreshToken": {
            "type": "string",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.refresh.sig"
          }
        }
      },
      "RefreshRequest": {
        "type": "object",
        "description": "토큰 재발급 요청 (FR-13). access_token 없이도 호출 가능하나 유효한 refresh_token이 필요하다(BR-1 예외).",
        "required": [
          "refreshToken"
        ],
        "properties": {
          "refreshToken": {
            "type": "string",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.refresh.sig"
          }
        }
      },
      "RefreshResponse": {
        "type": "object",
        "description": "토큰 재발급 성공 응답. 새 access_token만 발급한다.",
        "required": [
          "accessToken"
        ],
        "properties": {
          "accessToken": {
            "type": "string",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.newaccess.sig"
          }
        }
      },
      "UpdateUserRequest": {
        "type": "object",
        "description": "회원 정보 수정 요청 (FR-04). 변경 가능한 항목은 name, password로 한정하며 email은 수정 대상에서 제외된다(BR-10). 두 필드 모두 선택이며 최소 1개 이상 포함해야 한다.",
        "minProperties": 1,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30,
            "example": "김철수"
          },
          "password": {
            "type": "string",
            "format": "password",
            "minLength": 8,
            "example": "newPassword1"
          }
        }
      },
      "CreateCategoryRequest": {
        "type": "object",
        "description": "카테고리 등록 요청 (FR-05).",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20,
            "example": "업무"
          }
        }
      },
      "UpdateCategoryRequest": {
        "type": "object",
        "description": "카테고리 수정 요청 (FR-06). '기본' 카테고리는 수정 불가(BR-4).",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20,
            "example": "개인"
          }
        }
      },
      "CreateTodoRequest": {
        "type": "object",
        "description": "할일 등록 요청 (FR-07). categoryId 미지정 시 '기본' 카테고리로 자동 지정된다(BR-3). endDate는 startDate 이상이어야 한다(BR-6).",
        "required": [
          "title",
          "startDate",
          "endDate"
        ],
        "properties": {
          "categoryId": {
            "type": "string",
            "format": "uuid",
            "nullable": true,
            "description": "미지정 시 기본 카테고리로 자동 지정(BR-3)",
            "example": "b3f1c9a0-1234-4a5b-9c8d-1234567890ab"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "example": "API 명세서 작성"
          },
          "description": {
            "type": "string",
            "maxLength": 1000,
            "nullable": true,
            "example": "swagger.json 초안 작성"
          },
          "startDate": {
            "type": "string",
            "format": "date",
            "example": "2026-08-26"
          },
          "endDate": {
            "type": "string",
            "format": "date",
            "example": "2026-08-28"
          }
        }
      },
      "UpdateTodoRequest": {
        "type": "object",
        "description": "할일 수정 요청 (FR-10, FR-12). 완료 처리/취소도 isCompleted 필드 갱신으로 처리한다(BR-7). endDate < startDate이면 400(BR-6).",
        "minProperties": 1,
        "properties": {
          "categoryId": {
            "type": "string",
            "format": "uuid",
            "example": "b3f1c9a0-1234-4a5b-9c8d-1234567890ab"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "example": "API 명세서 작성(수정)"
          },
          "description": {
            "type": "string",
            "maxLength": 1000,
            "nullable": true,
            "example": "예제 포함해서 보강"
          },
          "startDate": {
            "type": "string",
            "format": "date",
            "example": "2026-08-26"
          },
          "endDate": {
            "type": "string",
            "format": "date",
            "example": "2026-08-29"
          },
          "isCompleted": {
            "type": "boolean",
            "description": "true로 설정 시 completedAt이 현재 일시로 설정되고, false로 되돌리면 completedAt이 null로 초기화된다(BR-7).",
            "example": true
          }
        }
      },
      "HealthResponse": {
        "type": "object",
        "required": [
          "status",
          "db"
        ],
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          },
          "db": {
            "type": "string",
            "enum": [
              "connected",
              "disconnected"
            ],
            "example": "connected"
          }
        }
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "인증되지 않은 요청(access_token 없음/만료/위조). BR-1.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "code": "UNAUTHORIZED",
              "message": "인증이 필요합니다."
            }
          }
        }
      },
      "Forbidden": {
        "description": "요청자가 소유하지 않은 리소스에 접근. BR-2.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "code": "FORBIDDEN",
              "message": "본인 소유의 리소스만 접근할 수 있습니다."
            }
          }
        }
      },
      "NotFound": {
        "description": "리소스를 찾을 수 없음.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "code": "NOT_FOUND",
              "message": "리소스를 찾을 수 없습니다."
            }
          }
        }
      },
      "ValidationError": {
        "description": "요청 값 유효성 검증 실패.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "code": "VALIDATION_ERROR",
              "message": "요청 값이 유효하지 않습니다."
            }
          }
        }
      }
    }
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "헬스 체크",
        "description": "서버 및 DB 커넥션 풀 상태를 확인한다. 인증 불필요(BR-1 예외, project_principle.md 5.7절).",
        "security": [],
        "responses": {
          "200": {
            "description": "정상",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                },
                "example": {
                  "status": "ok",
                  "db": "connected"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/signup": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "회원가입",
        "description": "이메일/비밀번호/이름으로 계정을 생성한다(FR-01). 이메일은 사용자 간 중복될 수 없다(BR-9). 인증 불필요(BR-1 예외).",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignupRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "가입 성공",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "409": {
            "description": "이메일 중복(BR-9)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": "EMAIL_ALREADY_EXISTS",
                  "message": "이미 가입된 이메일입니다."
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "로그인",
        "description": "이메일/비밀번호로 인증하고 access_token/refresh_token을 발급한다(FR-02). 실패 시 이메일 미존재/비밀번호 불일치를 구분하지 않는다(BR-11). 인증 불필요(BR-1 예외).",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "로그인 성공",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "description": "인증 실패(BR-11: 이메일 미존재/비밀번호 불일치 동일 메시지)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": "INVALID_CREDENTIALS",
                  "message": "이메일 또는 비밀번호가 올바르지 않습니다."
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "로그아웃",
        "description": "제시된 refresh_token을 무효화하여 세션을 종료한다(FR-03). access_token 없이(만료된 상태에서도) 호출할 수 있다 — 로그아웃은 refresh_token 소유만으로 수행되며 별도의 access_token 인증을 요구하지 않는다.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LogoutRequest"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "로그아웃 성공(본문 없음)"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/api/auth/refresh": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "토큰 재발급",
        "description": "access_token 만료 시 refresh_token으로 access_token을 재발급받는다(FR-13). access_token 없이 호출 가능하나 유효한 refresh_token이 필요하다(BR-1 예외).",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "재발급 성공",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RefreshResponse"
                }
              }
            }
          },
          "401": {
            "description": "refresh_token이 없거나 유효하지 않거나 만료됨(BR-1)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": "INVALID_REFRESH_TOKEN",
                  "message": "유효하지 않거나 만료된 토큰입니다."
                }
              }
            }
          }
        }
      }
    },
